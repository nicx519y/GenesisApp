pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 120, unit: 'MINUTES')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '15'))
    }

    parameters {
        choice(name: 'PLATFORM', choices: ['android', 'ios', 'both'], description: '要构建的平台')
        string(name: 'BRANCH', defaultValue: 'main', trim: true, description: 'origin 上的分支名')
        string(name: 'ANDROID_VERSION_NAME', defaultValue: '0.4.3', trim: true, description: 'Android versionName，例如 0.4.3')
        string(name: 'ANDROID_VERSION_CODE', defaultValue: '48', trim: true, description: 'Android versionCode，正整数')
        string(name: 'IOS_VERSION_NAME', defaultValue: '0.4.3', trim: true, description: 'iOS CFBundleShortVersionString，例如 0.4.3')
        string(name: 'IOS_BUILD_NUMBER', defaultValue: '48', trim: true, description: 'iOS CFBundleVersion，正整数')
    }

    environment {
        PATH = "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${env.PATH}"
        LANG = 'en_US.UTF-8'
        LC_ALL = 'en_US.UTF-8'
        RELEASE_ARTIFACT_DIR = "${WORKSPACE}/release_artifacts"
    }

    stages {
        stage('Validate host and parameters') {
            steps {
                sh '''#!/bin/bash
                    set -euo pipefail
                    [[ "$(uname -s)" == "Darwin" ]] || { echo "ERROR: Android+iOS 打包机必须运行在 macOS。" >&2; exit 1; }
                    for tool in git flutter java python3 shasum unzip; do
                      command -v "$tool" >/dev/null || { echo "ERROR: 缺少命令: $tool" >&2; exit 1; }
                    done
                    [[ "$BRANCH" =~ ^[A-Za-z0-9._/-]+$ ]] || { echo "ERROR: 分支名包含不安全字符。" >&2; exit 1; }
                    [[ "$BRANCH" != -* && "$BRANCH" != *..* && "$BRANCH" != /* && "$BRANCH" != */ ]] || {
                      echo "ERROR: 分支名格式非法。" >&2
                      exit 1
                    }
                '''
            }
        }

        stage('Clean checkout from origin') {
            steps {
                deleteDir()
                script {
                    try {
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: "refs/heads/${params.BRANCH}"]],
                            doGenerateSubmoduleConfigurations: false,
                            extensions: [
                                [$class: 'CleanBeforeCheckout', deleteUntrackedNestedRepositories: true],
                                [$class: 'CloneOption', depth: 1, noTags: true, reference: '', shallow: true, timeout: 20]
                            ],
                            userRemoteConfigs: [[
                                credentialsId: 'genesisapp-readonly',
                                url: 'git@github.com:nicx519y/GenesisApp.git'
                            ]]
                        ])
                    } catch (Exception checkoutError) {
                        error("无法检出 origin/${params.BRANCH}：请确认分支存在，并检查 genesisapp-readonly 凭据。原始错误：${checkoutError.message}")
                    }
                }
                sh 'git checkout --detach HEAD && echo "构建提交: $(git rev-parse HEAD)"'
            }
        }

        stage('Build and verify') {
            steps {
                sh '''#!/bin/bash
                    set -euo pipefail
                    tools/jenkins/local_release.sh \
                      --platform "$PLATFORM" \
                      --branch "$BRANCH" \
                      --android-version-name "$ANDROID_VERSION_NAME" \
                      --android-version-code "$ANDROID_VERSION_CODE" \
                      --ios-version-name "$IOS_VERSION_NAME" \
                      --ios-build-number "$IOS_BUILD_NUMBER" \
                      --repo-dir "$WORKSPACE" \
                      --artifact-dir "$RELEASE_ARTIFACT_DIR"
                '''
            }
        }

        stage('Confirm no Git changes') {
            steps {
                sh '''#!/bin/bash
                    set -euo pipefail
                    git diff --exit-code
                    git diff --cached --exit-code
                    if [[ -n "$(git status --short --untracked-files=no)" ]]; then
                      echo "ERROR: 构建过程修改了受 Git 跟踪的文件。" >&2
                      git status --short --untracked-files=no
                      exit 1
                    fi
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'release_artifacts/**/*', allowEmptyArchive: true, fingerprint: true
        }
        success {
            echo '构建与校验完成；本阶段没有 commit、push、tag 或商店上传。'
        }
        failure {
            echo '构建失败；请查看 Console Output。远端 Git 和应用商店均未被修改。'
        }
    }
}
