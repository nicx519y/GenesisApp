+import type {Session,StepRecord} from '../../../service/src/exploration/model';
+
+export function recordStatus(record:StepRecord,kind:'tasks'|'runs'){
+ if(record.diagnostic)return 'execution_error';
+ return kind==='tasks'&&record.verdict==='failed'?'attempt_failed':record.verdict;
+}
+export function explorationResults(session:Session){
+ const recipe=session.status==='report'?session.candidate:undefined;
+ const ids=new Set(recipe?.steps.map(step=>step.id)??[]);
+ const records=recipe?session.records.filter(record=>ids.has(record.id)):session.records;
+ const passed=records.filter(record=>record.verdict==='passed'&&!record.diagnostic).length;
+ const failed=records.filter(record=>record.verdict==='failed'&&!record.diagnostic).length;
+ const diagnostics=session.records.filter(record=>record.diagnostic).length;
+ const historyFailed=recipe?session.records.filter(record=>!ids.has(record.id)&&record.verdict==='failed'&&!record.diagnostic).length:0;
+ const complete=!!recipe&&records.length===recipe.steps.length&&passed+failed>0&&!records.some(record=>record.diagnostic||record.check&&record.verdict==='unobserved');
+ const result=complete?(failed?'failed':'passed'):'unknown';
+ return {result,hasRecipe:!!recipe,total:session.records.length,passed,failed,historyFailed,diagnostics};
+}
